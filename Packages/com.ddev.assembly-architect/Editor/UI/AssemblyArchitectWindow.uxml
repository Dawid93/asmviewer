<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="root" class="aa-root">
    <ui:VisualElement name="toolbar" class="aa-toolbar" />
    <ui:TwoPaneSplitView name="body" class="aa-body"
                         orientation="Horizontal"
                         fixed-pane-initial-dimension="320"
                         fixed-pane-index="1">
      <ui:VisualElement name="graph-host" class="aa-graph-host" />
      <ui:VisualElement name="inspector-host" class="aa-inspector-host" />
    </ui:TwoPaneSplitView>
    <ui:VisualElement name="status-bar" class="aa-status-bar">
      <ui:Label name="status-label" text="Ready" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
