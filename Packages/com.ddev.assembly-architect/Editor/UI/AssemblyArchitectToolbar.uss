.aa-toolbar-root {
  flex-grow: 1;
  height: 24px;
  min-height: 24px;
  flex-direction: row;
}

.aa-toolbar {
  flex-grow: 1;
  height: 24px;
  min-height: 24px;
}

.aa-toolbar-group {
  flex-direction: row;
  align-items: center;
}

.aa-toolbar-spacer {
  flex-grow: 1;
}

.aa-icon-button,
.aa-icon-toggle {
  width: 28px;
  min-width: 28px;
  height: 22px;
}

.aa-toolbar-icon {
  width: 16px;
  height: 16px;
  align-self: center;
}

.aa-layout-menu {
  min-width: 132px;
}

.aa-toolbar-search {
  min-width: 180px;
  max-width: 320px;
  flex-grow: 1;
}

.aa-overflow-menu {
  min-width: 34px;
}
